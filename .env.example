# 复制本文件为 .env 再填。key 只放这里，别写进代码，别提交。
#
# 智谱（glm-4.6，付费通道实测可用）
LLM_API_KEY=你的智谱key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.6

# DeepSeek 也能用：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
#
# 可选：配了 GITHUB_TOKEN 就能把搜索速率从 10 次/分钟提到 30 次/分钟。
# GITHUB_TOKEN=ghp_xxx
#
# 说明：模型调用失败不会丢数据，条目会标成 unscored；
# 不想花 token 就 scan --no-model，抓照样抓。
